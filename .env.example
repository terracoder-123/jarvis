# ─────────────────────────────────────────────────────────────────────────────
# J.A.R.V.I.S. — environment template
# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────
# Groq powers both speech-to-text (Whisper) and the primary LLM.
# Free, no credit card: https://console.groq.com/keys
GROQ_API_KEY=

# ── LLM provider failover order (optional) ───────────────────────────────────
# The agent walks this list, then walks each provider's model list. Providers
# without a key are silently skipped.
LLM_PROVIDERS=groq,cerebras,openrouter,gemini

# ── Optional fallback LLMs (all free tiers) ──────────────────────────────────
# Cerebras    — very fast Llama-3.3-70B   : https://cloud.cerebras.ai
# OpenRouter  — free :free models         : https://openrouter.ai/keys
# Gemini      — Google's free tier        : https://aistudio.google.com/apikey
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── Speech-to-text tuning (optional) ─────────────────────────────────────────
# whisper-large-v3 is more accurate; -turbo is faster.
STT_MODEL=whisper-large-v3
STT_FALLBACK_MODEL=whisper-large-v3-turbo
STT_LANGUAGE=en

# ── LiveKit (optional, for low-latency audio) ────────────────────────────────
# Leave blank to use Socket.IO fallback audio mode.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
MCP_PORT=8001

# ── Memory / context tuning (optional) ───────────────────────────────────────
HISTORY_TURNS=8
TOOL_RESULT_MAX=2500
MAX_TOOL_ROUNDS=6
